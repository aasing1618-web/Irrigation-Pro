# ---------------------------------------------------------------------------
# Configuration du dashboard d'administration d'Irrigation Pro
#
# Copiez ce fichier en « .env » puis adaptez les valeurs.
# Le fichier .env n'est jamais versionné (voir .gitignore à la racine).
# ---------------------------------------------------------------------------

# Adresse du serveur Irrigation Pro.
#
# En développement, le serveur tourne sur votre machine :
VITE_API_URL=http://localhost:4000
#
# En production, cette adresse DOIT commencer par « https:// ». Le dashboard
# refuse de démarrer sinon — c'est volontaire : ce sont les identifiants du
# propriétaire et les adresses de ses clients qui circulent ici.
# Exemple : VITE_API_URL=https://api.irrigation-pro.example
