# ---------------------------------------------------------------------------
# Configuration de l'application cliente Irrigation Pro
#
# Copiez ce fichier en « .env » puis adaptez les valeurs.
# Le fichier .env n'est jamais versionné (voir .gitignore à la racine).
# ---------------------------------------------------------------------------

# Adresse du serveur Irrigation Pro.
#
# En développement, le serveur tourne sur votre machine :
VITE_API_URL=http://localhost:4000
#
# En production (application distribuée aux clients), cette adresse DOIT
# commencer par « https:// ». L'application refuse de démarrer sinon —
# c'est volontaire : aucune donnée client ne doit circuler en clair.
# Exemple : VITE_API_URL=https://api.irrigation-pro.example
