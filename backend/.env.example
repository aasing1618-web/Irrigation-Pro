# --- Copier ce fichier en « .env » et remplir les valeurs. Ne jamais committer le .env. ---

# Environnement : development | test | production
NODE_ENV=development

# Port d'écoute du serveur
PORT=4000

# Connexion PostgreSQL
DATABASE_URL=postgresql://irrigation:motdepasse@localhost:5432/irrigation_pro

# Base utilisée par les tests automatisés (doit être une base SÉPARÉE :
# elle est vidée à chaque exécution des tests)
TEST_DATABASE_URL=postgresql://irrigation:motdepasse@localhost:5432/irrigation_pro_test

# Secret de signature des jetons d'authentification.
# Générer une valeur unique avec :  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=a_remplacer_par_une_valeur_aleatoire_de_48_octets_minimum

# Durées de vie des jetons
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Origines autorisées à appeler l'API (séparées par des virgules).
# tauri://localhost = application desktop installée
# http://localhost:5173 = application en développement
# http://localhost:5174 = dashboard admin en développement
CORS_ORIGINS=tauri://localhost,http://localhost:5173,http://localhost:5174

# Numéro WhatsApp du propriétaire, au format international sans « + » ni espaces
WHATSAPP_NUMBER=221000000000
