# --- Copier ce fichier en « .env » et remplir les valeurs. Ne jamais committer le .env. ---

# Environnement : development | test | production
NODE_ENV=development

# Port d'écoute du serveur
PORT=4000

# --- Base de données : PostgreSQL hébergé par Supabase (projet irrigation-pro) ---
#
# Où trouver ces valeurs : tableau de bord Supabase →
#   Project Settings → Database → Connection string
#
# Deux adresses sont proposées, elles ne servent pas à la même chose :
#
#   • Le POOLER en mode transaction (port 6543) — c'est celle que le serveur
#     utilise au quotidien. Elle supporte beaucoup de connexions simultanées.
#   • La connexion DIRECTE (port 5432) — réservée aux migrations, qui créent
#     et modifient des tables. Le pooler gère mal ces opérations longues.
#
# La connexion est TOUJOURS chiffrée : la base est distante, même en développement.

DATABASE_URL=postgresql://postgres.xxxxxxxx:MOT_DE_PASSE@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Facultative : utilisée uniquement par « npm run migrate ».
# À défaut, les migrations passent par DATABASE_URL.
DIRECT_DATABASE_URL=postgresql://postgres:MOT_DE_PASSE@db.xxxxxxxx.supabase.co:5432/postgres

# Facultative : chemin vers un certificat d'autorité, si le certificat de la
# base n'est pas reconnu par votre système. C'est la SEULE réponse acceptable à
# une erreur de certificat — ne désactivez jamais la vérification TLS.
# DATABASE_SSL_CA=./certs/supabase-ca.crt

# Base utilisée par les tests automatisés. Elle doit être un projet Supabase
# SÉPARÉ : son contenu est considéré comme jetable.
TEST_DATABASE_URL=

# Secret de signature des jetons d'authentification.
# Générer une valeur unique avec :  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=a_remplacer_par_une_valeur_aleatoire_de_48_octets_minimum

# Durées de vie des jetons
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Origines autorisées à appeler l'API (séparées par des virgules).
# tauri://localhost = application desktop installée
# http://localhost:5173 = application en développement
# http://localhost:5174 = dashboard admin en développement
CORS_ORIGINS=tauri://localhost,http://localhost:5173,http://localhost:5174

# Numéro WhatsApp du propriétaire, au format international sans « + » ni espaces
WHATSAPP_NUMBER=221778608247

# Dossier où sont rangés les rapports PDF générés.
# Facultative — par défaut « backend/storage/rapports ».
#
# ⚠ CE DOSSIER FAIT PARTIE DES DONNÉES À SAUVEGARDER, au même titre que la base.
#   Un rapport porte une référence imprimée et déjà remise au client final : il
#   est figé sur disque, et non régénéré à la demande, précisément pour qu'il ne
#   change jamais après avoir été remis. Si le fichier disparaît, l'API le dit
#   franchement plutôt que de fabriquer un document différent sous la même
#   référence.
# REPORTS_STORAGE_DIR=./storage/rapports
